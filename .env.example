APP_NAME=Hadir
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://hadir.test
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

